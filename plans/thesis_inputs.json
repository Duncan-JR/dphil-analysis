    "phase_runs": "In tsinfer-anc-eval: uv run python /path/to/dphil-analysis/scripts/extract_phase_data.py --data-prefix OutOfAfrica_3G09-chr20-L0-R2e7-n6000-s1 --data-folder data/anc_eval_new --output-folder /path/to/dphil-analysis/data/ch3 --n-per-sim 2 --replicate 0 --spacing-labels 2e5 2e6 2e7 --left 0 --right 20000000",
